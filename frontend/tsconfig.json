{
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*"
    ],
    "compilerOptions": {
        // Previously inherited from @vue/tsconfig, which also set
        // jsxImportSource to "vue" - the reason the React overrides below had to
        // exist. Stated outright now that nothing extends it.
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "useDefineForClassFields": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "fam-app-acsctl-api/*": [
                "../client-code-gen/gen/app-access-control-api/*"
            ],
            "fam-admin-mgmt-api/*": [
                "../client-code-gen/gen/admin-management-api/*"
            ]
        },
        "allowJs": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "types": [
            "vite/client"
        ],
        "esModuleInterop": true,
        "strict": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    },
    "references": [
        {
            "path": "./tsconfig.config.json"
        },
        {
            "path": "./tsconfig.e2e.json"
        }
    ]
}
