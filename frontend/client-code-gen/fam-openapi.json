          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PermissionAuditHistoryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/identity-lookup/users/idir/search" : {
      "get" : {
        "tags" : [ "IDIR/BCeID Proxy" ],
        "summary" : "Search IDIR users",
        "description" : "Search for IDIR users.",
        "operationId" : "search_idir_users",
        "parameters" : [ {
          "name" : "firstName",
          "in" : "query",
          "description" : "IDIR first name search value (min 2 chars)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "description" : "IDIR first name search value (min 2 chars)",
            "maxLength" : 50,
            "minLength" : 0
          }
        }, {
          "name" : "lastName",
          "in" : "query",
          "description" : "IDIR last name search value (min 2 chars)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "description" : "IDIR last name search value (min 2 chars)",
            "maxLength" : 50,
            "minLength" : 0
          }
        }, {
          "name" : "userId",
          "in" : "query",
          "description" : "IDIR user id search value (min 2 chars)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "description" : "IDIR user id search value (min 2 chars)",
            "maxLength" : 20,
            "minLength" : 0
          }
        }, {
          "name" : "pageSize",
          "in" : "query",
          "description" : "Number of records to return",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Number of records to return",
            "maximum" : 500,
            "minimum" : 10
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserLookupIdirSearchResult"
                }
              }
            }
          }
        }
      }
    },
