  "components" : {
    "schemas" : {
      "FamUserUpdateEntryDto" : {
        "properties" : {
          "user_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "user_name" : {
            "type" : "string"
          },
          "user_type" : {
            "type" : "string"
          },
          "user_guid" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        }
      },
      "FamUserUpdateResponse" : {
        "properties" : {
          "total_db_users_count" : {
            "type" : "integer",
            "format" : "int64"
          },
          "current_page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "users_count_on_page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "run_on" : {
            "type" : "string",
            "format" : "date-time"
          },
          "elapsed" : {
            "type" : "string"
          },
          "success_user_update_list" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FamUserUpdateEntryDto"
            }
          },
          "failed_user_update_list" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FamUserUpdateEntryDto"
            }
          },
          "ignored_user_update_list" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FamUserUpdateEntryDto"
            }
          },
          "mismatch_user_update_list" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FamUserUpdateEntryDto"
            }
          }
        }
      },
      "CssUserRoleAssignmentRequest" : {
        "properties" : {
          "user_guid" : {
            "type" : "string",
            "minLength" : 1
          },
          "user_type" : {
            "$ref" : "#/components/schemas/UserType"
          },
          "role_name" : {
            "type" : "string",
            "minLength" : 1
          },
          "target_user_email" : {
            "type" : "string",
            "format" : "email"
          },
          "scope_type" : {
            "type" : "string"
          },
          "scope_values" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "role_name", "user_guid", "user_type" ]
      },
      "UserType" : {
        "type" : "string",
        "enum" : [ "I", "B", "CD", "CT", "CP" ]
      },
      "CssUserRoleAssignmentResult" : {
        "properties" : {
          "role_name" : {
            "type" : "string"
          },
          "role_created" : {
            "type" : "boolean"
          },
          "assigned" : {
            "type" : "boolean"
          },
          "error_message" : {
            "type" : "string"
          },
          "email_sending_status" : {
            "$ref" : "#/components/schemas/EmailSendingStatus"
          }
        },
        "required" : [ "assigned", "email_sending_status", "role_created", "role_name" ]
      },
      "EmailSendingStatus" : {
        "type" : "string",
        "enum" : [ "NOT_REQUIRED", "SENT_TO_EMAIL_SERVICE_SUCCESS", "SENT_TO_EMAIL_SERVICE_FAILURE" ]
      },
      "CssRoleCreateRequest" : {
        "properties" : {
          "role_code" : {
            "type" : "string",
            "example" : "FREP_ADMINISTRATOR",
            "minLength" : 1
          },
          "description" : {
            "type" : "string",
            "example" : "FREP Administrator",
            "maxLength" : 150,
            "minLength" : 0
          },
          "requires_district" : {
            "type" : "boolean"
          },
          "requires_forest_client" : {
            "type" : "boolean"
          }
        },
        "required" : [ "description", "role_code" ]
      },
      "CssRoleOptionDto" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "display_name" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "role_code" : {
            "type" : "string"
          },
          "composite" : {
            "type" : "boolean"
          },
          "composites" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "role_type_district" : {
            "type" : "boolean"
          },
          "role_type_client" : {
            "type" : "boolean"
          }
        },
        "required" : [ "composite", "composites", "name", "role_type_client", "role_type_district" ]
      },
      "SelfDto" : {
        "properties" : {
          "user_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "user_name" : {
            "type" : "string"
          },
          "user_type_code" : {
            "type" : "string"
          },
          "first_name" : {
            "type" : "string"
          },
          "last_name" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "access_roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "is_delegated_admin" : {
            "type" : "boolean"
          },
          "requires_accept_tc" : {
            "type" : "boolean"
          }
        }
      },
      "PermissionAuditHistoryDto" : {
        "properties" : {
          "privilege_change_audit_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "create_date" : {
            "type" : "string",
            "format" : "date-time"
          },
          "create_user" : {
            "type" : "string"
          },
          "change_date" : {
            "type" : "string",
            "format" : "date-time"
          },
          "change_performer_user_details" : {
            "$ref" : "#/components/schemas/PrivilegeChangePerformerDto"
          },
          "change_performer_user_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "privilege_change_type_code" : {
            "$ref" : "#/components/schemas/PrivilegeChangeType"
          },
          "privilege_change_type_description" : {
            "type" : "string"
          },
          "privilege_details" : {
            "$ref" : "#/components/schemas/PrivilegeDetailsDto"
          }
        },
        "required" : [ "change_date", "change_performer_user_details", "change_performer_user_id", "create_date", "create_user", "privilege_change_audit_id", "privilege_change_type_code", "privilege_change_type_description", "privilege_details" ]
      },
      "PrivilegeChangePerformerDto" : {
        "properties" : {
          "username" : {
            "type" : "string"
          },
          "first_name" : {
            "type" : "string"
          },
          "last_name" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ]
      },
      "PrivilegeChangeType" : {
        "type" : "string",
        "enum" : [ "GRANT", "REVOKE", "UPDATE", "CREATE_ROLE" ]
      },
      "PrivilegeDetailsDto" : {
        "properties" : {
          "permission_type" : {
            "$ref" : "#/components/schemas/PrivilegeDetailsPermissionType"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PrivilegeDetailsRoleDto"
            }
          },
          "consistent" : {
            "type" : "boolean"
          }
        },
        "required" : [ "permission_type" ]
      },
      "PrivilegeDetailsPermissionType" : {
        "type" : "string",
        "enum" : [ "End User", "Delegated Admin", "Application Admin", "Role Definition" ]
      },
      "PrivilegeDetailsRoleDto" : {
        "properties" : {
          "role" : {
            "type" : "string"
