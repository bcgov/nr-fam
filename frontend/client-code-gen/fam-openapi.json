{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Forest Access Management - FAM - API",
    "description" : "Forest Access Management API. Defines who has access to which applications, and the roles they operate under once access is granted.\n\nCovers both the app-access-control and admin-management surfaces that upstream FAM served from two separate APIs.",
    "contact" : {
      "name" : "Team Heartwood",
      "url" : "https://apps.nrs.gov.bc.ca/int/confluence/display/FSAST1/Team+Heartwood",
      "email" : "SIBIFSAF@Victoria1.gov.bc.ca"
    },
    "license" : {
      "name" : "Apache 2.0",
      "url" : "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Relative to the host serving this document"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/users/users-information" : {
      "put" : {
        "tags" : [ "FAM User" ],
        "summary" : "Refresh stored user details from the identity directory",
        "description" : "Guarded by the X-API-Key shared secret, not a bearer token.",
        "operationId" : "update_user_information_from_directory",
        "parameters" : [ {
          "name" : "X-API-Key",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1
          }
        }, {
          "name" : "perPage",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 100
          }
        }, {
          "name" : "usePagination",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FamUserUpdateResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "apiKey" : [ ]
        } ]
      }
    },
    "/css-applications/{integrationId}/{environment}/user-role-assignments" : {
      "get" : {
        "tags" : [ "CSS Integrations" ],
        "summary" : "List every user/role assignment in a CSS integration environment",
        "operationId" : "get_css_user_role_assignments",
        "parameters" : [ {
          "name" : "integrationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "environment",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CssUserRoleRowDto"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "CSS Integrations" ],
        "summary" : "Grant a role, creating a scope-specific role if needed",
        "operationId" : "create_css_user_role_assignment",
        "parameters" : [ {
          "name" : "integrationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "environment",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CssUserRoleAssignmentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CssUserRoleAssignmentResult"
                  }
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "CSS Integrations" ],
        "summary" : "Revoke a role from a user",
        "operationId" : "delete_css_user_role_assignment",
        "parameters" : [ {
          "name" : "integrationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "environment",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CssUserRoleRevokeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/css-applications/{integrationId}/{environment}/roles" : {
      "get" : {
        "tags" : [ "CSS Integrations" ],
