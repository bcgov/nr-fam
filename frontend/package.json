{
  "name": "fam-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install-frontend": "npm ci --ignore-scripts",
    "dev": "vite --host",
    "preview": "vite preview --port 3000",
    "type-check": "vue-tsc --noEmit",
    "build-only": "vite build",
    "build": "run-p type-check build-only",
    "build:tokens": "style-dictionary build --config style-dictionary.config.json --verbose",
    "deploy": "npm run install-frontend && npm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test-watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test-coverage": "vitest run --coverage",
    "pree2e:login": "playwright install chromium && rm -f e2e/.auth/user.json",
    "e2e:login": "playwright test --project=setup --headed",
    "pree2e": "playwright install chromium",
    "e2e": "playwright test --project=chromium",
    "pree2e:all-browsers": "playwright install",
    "e2e:all-browsers": "playwright test",
    "pree2e:ui": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@bcgov-nr/nr-theme": "~1.8.9",
    "@carbon/icons-vue": "^10.99.1",
    "@carbon/type": "^11.31.0",
    "@primeuix/themes": "^1.2.3",
    "@tanstack/vue-query": "^5.56.2",
    "axios": "^1.18.1",
    "bootstrap": "^5.3.8",
    "fam-api": "file:./client-code-gen/gen/fam-api",
    "luxon": "^3.5.0",
    "oidc-client-ts": "^3.1.0",
    "primevue": "^4.4.1",
    "vee-validate": "^4.12.6",
    "vue": "^3.4.23",
    "vue-router": "^4.3.2",
    "wait-for-expect": "^3.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tanstack/vue-query-devtools": "^5.56.2",
    "@tsconfig/node24": "^24.0.0",
    "@types/bootstrap": "^5.2.5",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.56.0",
    "sass": "^1.77.1",
    "style-dictionary": "^5.4.4",
    "typescript": "^5.6.2",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^8.1.0",
    "vue-tsc": "^2.0.0",
    "yup": "^1.4.0"
  }
}
