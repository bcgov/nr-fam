{
    "name": "fam-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "install-frontend": "npm ci --ignore-scripts",
        "dev": "vite --host",
        "preview": "vite preview --port 3000",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "build-only": "vite build",
        "build": "run-p type-check build-only",
        "build:tokens": "style-dictionary build --config style-dictionary.config.json --verbose",
        "deploy": "npm run install-frontend && npm run build",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test-watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test-coverage": "vitest run --coverage",
        "pree2e:login": "playwright install chromium && rm -f e2e/.auth/user.json",
        "e2e:login": "playwright test --project=setup --headed",
        "pree2e": "playwright install chromium",
        "e2e": "playwright test --project=chromium",
        "pree2e:all-browsers": "playwright install",
        "e2e:all-browsers": "playwright test",
        "pree2e:ui": "playwright install chromium",
        "e2e:ui": "playwright test --ui",
        "e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@bcgov-nr/nr-theme": "~1.8.9",
        "@carbon/icons-react": "^11.86.0",
        "@carbon/react": "^1.105.0",
        "@carbon/type": "^11.31.0",
        "@tanstack/react-query": "^5.102.3",
        "axios": "^1.18.1",
        "bootstrap": "^5.3.8",
        "fam-api": "file:./client-code-gen/gen/fam-api",
        "luxon": "^3.5.0",
        "oidc-client-ts": "^3.1.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.2",
        "wait-for-expect": "^3.0.2"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "overrides": {
        "form-data": "4.0.6",
        "nanoid": "3.3.18"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@tsconfig/node24": "^24.0.0",
        "@types/bootstrap": "^5.2.5",
        "@types/luxon": "^3.4.2",
        "@types/node": "^20.16.11",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.0",
        "esbuild": "^0.28.2",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.33.0",
        "npm-run-all2": "^9.0.2",
        "playwright": "^1.56.0",
        "sass": "^1.77.1",
        "style-dictionary": "^5.4.4",
        "typescript": "^5.6.2",
        "vite": "^8.1.0",
        "yup": "^1.4.0"
    }
}
