# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip

	# API requests are proxied to the backend Service in-cluster. handle_path
	# STRIPS the /api prefix: the backend serves its paths at the root, so
	# /api/fam-applications must reach it as /fam-applications.
	#
	# Proxying rather than calling the backend directly keeps the API same-origin.
	# That means no CORS, no second OpenShift Route, and the frontend's strict
	# connect-src 'self' CSP is satisfied without listing another host.
	handle_path /api/* {
		reverse_proxy {$BACKEND_URL} {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else is the SPA: serve the file if it exists, otherwise
	# index.html so client-side routing works on a deep link or refresh.
	handle {
		@spa_router {
			file {
				try_files {path} /index.html
			}
		}
		rewrite @spa_router {http.matchers.file.relative}
		file_server
	}
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca;
			script-src 'self' https://*.gov.bc.ca;
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com 'unsafe-inline'; 
			font-src 'self' https://fonts.gstatic.com; 
			img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org;
			frame-ancestors 'self'; 
			form-action 'self';
			block-all-mixed-content;
			connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
